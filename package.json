{
  "name": "clip-editor",
  "productName": "Clip Editor",
  "version": "1.43.3",
  "description": "Trim and share video clips",
  "main": "main.js",
  "author": "EchoCR772",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "mediabunny": "^1.62.1"
  },
  "build": {
    "appId": "com.cristian.cliptrimmer",
    "productName": "Clip Editor",
    "files": [
      "main.js",
      "preload.js",
      "smartcut.js",
      "renderer/**",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Clip Editor",
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Clip-Editor-Setup-${version}.exe"
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EchoCR772",
        "repo": "clip-editor",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EchoCR772/clip-editor.git"
  }
}
