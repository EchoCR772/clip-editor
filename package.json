{
  "name": "clip-trimmer",
  "productName": "Clip Trimmer",
  "version": "1.0.0",
  "description": "Simple desktop video clip trimmer",
  "main": "main.js",
  "author": "Cristian Rivera",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win --dir"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "mediabunny": "^1.62.1"
  },
  "build": {
    "appId": "com.cristian.cliptrimmer",
    "productName": "Clip Trimmer",
    "files": [
      "main.js",
      "preload.js",
      "smartcut.js",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Clip Trimmer",
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Clip-Trimmer-Setup-${version}.exe"
    },
    "directories": {
      "output": "dist"
    }
  }
}
